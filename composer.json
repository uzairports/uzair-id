{
    "name": "uzairports/uzair-id",
    "description": "OAuth 2.0 Integration with Uzbekistan Airports Single Sign-On System for Laravel",
    "type": "library",
    "keywords": [
        "laravel",
        "socialite",
        "sso",
        "oauth2",
        "uzairports"
    ],
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "JSC Uzbekistan Airports",
            "email": "it@uzairports.com",
            "homepage": "https://github.com/uzairports"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.15 || ^8.0",
        "guzzlehttp/promises": "^2.5 || ^3.0",
        "illuminate/auth": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/encryption": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/session": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/translation": "^13.0",
        "laravel/socialite": "^5.31",
        "nesbot/carbon": "^3.13",
        "psr/http-message": "^1.0 || ^2.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.11",
        "laravel/pint": "^1.31",
        "mockery/mockery": "^1.6.15",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "Uzairports\\Uzairid\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uzairports\\Uzairid\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Uzairports\\Uzairid\\Providers\\UzairServiceProvider"
            ]
        }
    }
}
