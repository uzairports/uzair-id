{
    "name": "uzairports/uzair-id",
    "description": "OAuth 2.0 Integration with Uzbekistan Airports Single Sign-On System for Laravel",
    "type": "library",
    "keywords": [
        "laravel",
        "socialite",
        "sso",
        "oauth2",
        "uzairports"
    ],
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "JSC Uzbekistan Airports",
            "email": "it@uzairports.com",
            "homepage": "https://github.com/uzairports"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/translation": "^11.0|^12.0|^13.0",
        "laravel/socialite": "^5.31"
    },
    "require-dev": {
        "larastan/larastan": "^3.11",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Uzairports\\Uzairid\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uzairports\\Uzairid\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Uzairports\\Uzairid\\Providers\\UzairServiceProvider"
            ]
        }
    }
}
